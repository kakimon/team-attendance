// Cloudflare Workers — static assets only (the Nuxt SPA built by `npm run generate`).
// No Worker script: "main" is intentionally absent, so every request is answered from the files in
// .output/public and no billable code runs. Deploy (separate approval): `npx wrangler deploy` after `npm run generate`.
// Build-time variables (Cloudflare build settings, never committed): NUXT_PUBLIC_SUPABASE_URL,
// NUXT_PUBLIC_SUPABASE_ANON_KEY (publishable key). NUXT_APP_BASE_URL stays unset (= "/").
{
  "name": "team-attendance",
  "compatibility_date": "2026-05-01",
  "assets": {
    "directory": "./.output/public",
    // A URL with no file (e.g. /join/<token>, /t/<id>, /auth/callback, a reload on any app page) gets
    // /index.html with 200, and the SPA router renders it (unknown paths show the app's own 404 page).
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  },
  "workers_dev": true,
  "preview_urls": false
}
